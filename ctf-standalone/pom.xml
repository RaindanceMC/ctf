<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>ctf-build</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ctf-standalone</artifactId>
    <!-- Published at the plugin's own version. -->
    <version>${plugin.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Capture the Flag</name>
    <description>
        Rain's Capture the Flag, as a plugin of its own: the ctf module and the standard wrapper,
        shaded together.
    </description>

    <properties>
        <plugin.name>RainsCaptureTheFlag</plugin.name>
        <!-- 0.1.0: Capture the Flag — classic, one flag, neutral flag and guild war; classes, power-ups, supply drops,
             jump pads, a control point, mutators, map and mutator votes, an announcer, awards, levels, daily challenges,
             parties, team voice, spectators, lobby parkour and leaderboards. -->
        <!-- 0.2.0: a hub to land in — hub/hub.schem built into a world of its own (hub-world), the lobby's spawn,
             protected, and off its edge is back to the spawn; /ctf admin hub [build|rebuild]. -->
        <!-- 0.10.1: the kept inventory side does not save a claim's or /fly's lent flight, so coming back from a round never leaves somebody flying for good. -->
        <plugin.version>0.11.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>ctf-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!-- StandaloneJarTest reads the built jar, so it runs after the jar exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
